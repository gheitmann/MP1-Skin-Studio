<?xml version="1.0" encoding="utf-8"?>
<!-- Eigene Editor-Demo: freie Gruppen ohne automatische Layoutregeln. -->
<window>
  <id>99101</id>
  <controls>
    <control>
      <type>label</type><id>0</id><description>Gruppen ausprobieren</description>
      <posX>200</posX><posY>160</posY><width>1500</width><height>90</height>
      <font>TitanLight32</font><label>Zusammengehörige Elemente im Baum auswählen</label>
    </control>
    <control>
      <type>group</type><id>300</id><description>Medienbereich</description>
      <posX>210</posX><posY>300</posY><width>1500</width><height>600</height>
      <!-- Kommentar und unbekannte Eigenschaft sollen erhalten bleiben. -->
      <editorUnknown keep="yes">Gruppen-Demo</editorUnknown>
      <control>
        <type>image</type><id>0</id><description>Panel</description>
        <posX>210</posX><posY>300</posY><width>1500</width><height>600</height>
        <texture>Studio/Panel-transparent.png</texture>
      </control>
      <control>
        <type>label</type><id>0</id><description>Titel</description>
        <posX>270</posX><posY>350</posY><width>1300</width><height>80</height>
        <font>TitanLight32</font><label>Deine Mediensammlung</label>
      </control>
      <control>
        <type>group</type><id>301</id><description>Aktionen</description>
        <posX>300</posX><posY>620</posY><width>1300</width><height>200</height>
        <control>
          <type>button</type><id>310</id><description>Filme öffnen</description>
          <posX>330</posX><posY>650</posY><width>500</width><height>120</height>
          <label>Filme öffnen</label><font>TitanLight22</font>
          <textureFocus>Studio/Schaltflaeche-blau.png</textureFocus>
          <textureNoFocus>Studio/Schaltflaeche-dunkel.png</textureNoFocus>
        </control>
        <control>
          <type>button</type><id>311</id><description>Serien öffnen</description>
          <posX>950</posX><posY>650</posY><width>500</width><height>120</height>
          <label>Serien öffnen</label><font>TitanLight22</font>
          <textureFocus>Studio/Schaltflaeche-blau.png</textureFocus>
          <textureNoFocus>Studio/Schaltflaeche-dunkel.png</textureNoFocus>
        </control>
      </control>
    </control>
  </controls>
</window>
