<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Beispielmenü des Editors; IDs und Navigation nur für diesen Demo-Bildschirm. -->
<window>
  <controls>
    <control>
      <description>Willkommen</description>
      <type>label</type>
      <id>0</id>
      <posX>140</posX>
      <posY>310</posY>
      <width>1500</width>
      <height>90</height>
      <font>TitanLight32</font>
      <label>Dein Abend. Deine Oberfläche.</label>
      <textcolor>ffffffff</textcolor>
    </control>
    <control>
      <description>Untertitel</description>
      <type>label</type>
      <id>0</id>
      <posX>144</posX>
      <posY>410</posY>
      <width>1400</width>
      <height>60</height>
      <font>TitanLight14</font>
      <label>Element anklicken, verschieben und rechts die Eigenschaften anpassen.</label>
      <textcolor>ff9fb7d0</textcolor>
    </control>
    <control>
      <description>Filme</description>
      <type>button</type>
      <id>10</id>
      <posX>140</posX>
      <posY>580</posY>
      <width>470</width>
      <height>130</height>
      <label>Filme</label>
      <textureNoFocus>Studio/Schaltflaeche-dunkel.png</textureNoFocus>
      <textureFocus>Studio/Schaltflaeche-blau.png</textureFocus>
      <font>TitanLight22</font>
      <align>center</align>
      <onright>11</onright>
      <onleft>12</onleft>
      <hyperlink>25</hyperlink>
      <!-- Dieser Kommentar und der unbekannte Eintrag sollen erhalten bleiben. -->
      <editorUnknown mustKeep="yes">Unbekannte XML-Eigenschaften bleiben erhalten.</editorUnknown>
    </control>
    <control>
      <description>Serien</description>
      <type>button</type>
      <id>11</id>
      <posX>720</posX>
      <posY>580</posY>
      <width>470</width>
      <height>130</height>
      <label>Serien</label>
      <textureNoFocus>Studio/Schaltflaeche-dunkel.png</textureNoFocus>
      <textureFocus>Studio/Schaltflaeche-blau.png</textureFocus>
      <font>TitanLight22</font>
      <align>center</align>
      <onleft>10</onleft>
      <onright>12</onright>
    </control>
    <control>
      <description>Musik</description>
      <type>button</type>
      <id>12</id>
      <posX>1300</posX>
      <posY>580</posY>
      <width>470</width>
      <height>130</height>
      <label>Musik</label>
      <textureNoFocus>Studio/Schaltflaeche-dunkel.png</textureNoFocus>
      <textureFocus>Studio/Schaltflaeche-blau.png</textureFocus>
      <font>TitanLight22</font>
      <align>center</align>
      <onleft>11</onleft>
      <onright>10</onright>
    </control>
    <control>
      <description>Editor-Hinweis</description>
      <type>label</type>
      <id>0</id>
      <posX>144</posX>
      <posY>890</posY>
      <width>1600</width>
      <height>60</height>
      <font>TitanLight12</font>
      <label>Uhr und Datum oben stammen aus Titans originaler common.time.xml.</label>
      <textcolor>ff9fb7d0</textcolor>
    </control>
    <control>
      <description>Beispiel-Filmtitel</description>
      <type>label</type>
      <id>0</id>
      <posX>144</posX>
      <posY>770</posY>
      <width>1500</width>
      <height>60</height>
      <font>TitanLight22</font>
      <label>#selecteditem</label>
      <textcolor>ffbdd9ed</textcolor>
    </control>
    <control>
      <description>Beispiel-Nachrichten</description>
      <type>label</type>
      <id>0</id>
      <posX>144</posX>
      <posY>840</posY>
      <width>1500</width>
      <height>45</height>
      <font>TitanLight14</font>
      <label>Nachrichten: #myNotifier.Messages.Count.Unread</label>
      <visible>!string.equals(#myNotifier.Messages.Count.Unread,0)</visible>
      <textcolor>ffffc56c</textcolor>
    </control>
  </controls>
</window>
