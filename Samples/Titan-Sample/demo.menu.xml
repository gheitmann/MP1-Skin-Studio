<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Beispielmenü des Editors; IDs und Navigation nur für diesen Demo-Imageschirm. -->
<window>
  <controls>
    <control>
      <description>Welcome</description>
      <type>label</type>
      <id>0</id>
      <posX>140</posX>
      <posY>310</posY>
      <width>1500</width>
      <height>90</height>
      <font>TitanLight32</font>
      <label>Your evening. Your interface.</label>
      <textcolor>ffffffff</textcolor>
    </control>
    <control>
      <description>Subtitle</description>
      <type>label</type>
      <id>0</id>
      <posX>144</posX>
      <posY>410</posY>
      <width>1400</width>
      <height>60</height>
      <font>TitanLight14</font>
      <label>Click an element, move it and adjust its properties on the right.</label>
      <textcolor>ff9fb7d0</textcolor>
    </control>
    <control>
      <description>Movies</description>
      <type>button</type>
      <id>10</id>
      <posX>140</posX>
      <posY>580</posY>
      <width>470</width>
      <height>130</height>
      <label>Movies</label>
      <textcolor>ffffffff</textcolor>
      <textcolorNoFocus>ffffffff</textcolorNoFocus>
      <textalign>center</textalign>
      <textvalign>middle</textvalign>
      <textXOff>0</textXOff>
      <textYOff>0</textYOff>
      <textureNoFocus>Studio/Button-dark.png</textureNoFocus>
      <textureFocus>Studio/Button-blue.png</textureFocus>
      <font>TitanLight22</font>
      <align>center</align>
      <onright>11</onright>
      <onleft>12</onleft>
      <hyperlink>25</hyperlink>
      <!-- Dieser Kommentar und der unbekannte Eintrag sollen erhalten bleiben. -->
      <editorUnknown mustKeep="yes">Unbekannte XML-Propertyen bleiben erhalten.</editorUnknown>
    </control>
    <control>
      <description>Series</description>
      <type>button</type>
      <id>11</id>
      <posX>720</posX>
      <posY>580</posY>
      <width>470</width>
      <height>130</height>
      <label>Series</label>
      <textcolor>ffffffff</textcolor>
      <textcolorNoFocus>ffffffff</textcolorNoFocus>
      <textalign>center</textalign>
      <textvalign>middle</textvalign>
      <textXOff>0</textXOff>
      <textYOff>0</textYOff>
      <textureNoFocus>Studio/Button-dark.png</textureNoFocus>
      <textureFocus>Studio/Button-blue.png</textureFocus>
      <font>TitanLight22</font>
      <align>center</align>
      <onleft>10</onleft>
      <onright>12</onright>
    </control>
    <control>
      <description>Music</description>
      <type>button</type>
      <id>12</id>
      <posX>1300</posX>
      <posY>580</posY>
      <width>470</width>
      <height>130</height>
      <label>Music</label>
      <textcolor>ffffffff</textcolor>
      <textcolorNoFocus>ffffffff</textcolorNoFocus>
      <textalign>center</textalign>
      <textvalign>middle</textvalign>
      <textXOff>0</textXOff>
      <textYOff>0</textYOff>
      <textureNoFocus>Studio/Button-dark.png</textureNoFocus>
      <textureFocus>Studio/Button-blue.png</textureFocus>
      <font>TitanLight22</font>
      <align>center</align>
      <onleft>11</onleft>
      <onright>10</onright>
    </control>
    <control>
      <description>Editor-Information</description>
      <type>label</type>
      <id>0</id>
      <posX>144</posX>
      <posY>890</posY>
      <width>1600</width>
      <height>60</height>
      <font>TitanLight12</font>
      <label>The clock and date above come from Titan's original common.time.xml.</label>
      <textcolor>ff9fb7d0</textcolor>
    </control>
    <control>
      <description>Sample movie title</description>
      <type>label</type>
      <id>0</id>
      <posX>144</posX>
      <posY>770</posY>
      <width>1500</width>
      <height>60</height>
      <font>TitanLight22</font>
      <label>#selecteditem</label>
      <textcolor>ffbdd9ed</textcolor>
    </control>
    <control>
      <description>Sample news</description>
      <type>label</type>
      <id>0</id>
      <posX>144</posX>
      <posY>840</posY>
      <width>1500</width>
      <height>45</height>
      <font>TitanLight14</font>
      <label>News: #myNotifier.Messages.Count.Unread</label>
      <visible>!string.equals(#myNotifier.Messages.Count.Unread,0)</visible>
      <textcolor>ffffc56c</textcolor>
    </control>
  </controls>
</window>
